# Local app binds to loopback. Set a strong token for owner access.
CALBOK_ADMIN_TOKEN=
CALBOK_DB_PATH=./data/calbok.sqlite
# Required for HTTPS reverse-proxy deployments, e.g. https://calbok.up.railway.app
CALBOK_PUBLIC_ORIGIN=
# Optional comma-separated exact owned origins, e.g. https://calbok.xyz (no slash/path/wildcards).
CALBOK_ADDITIONAL_ORIGINS=
# Email code login (Resend + verified sender). Keep signup closed until ready.
RESEND_API_KEY=
CALBOK_EMAIL_FROM=
CALBOK_OWNER_EMAIL=
# Optional separate random 32+ character secret; defaults to the strong admin key.
CALBOK_SESSION_SECRET=
CALBOK_PUBLIC_SIGNIN_ENABLED=false
# Member provider reads/writes and automatic settlement remain disabled by default.
CALBOK_USER_PROVIDER_ACCESS=false
# Production launcher enables the runtime marker; reads at most 3 due receipts/minute.
CALBOK_WORKER_ENABLED=false
TATUM_API_KEY=
# GMGN query-only access. This app does not use GMGN signing or trading keys.
GMGN_API_KEY=
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=
# Explicit attestation required; do not set until account/relayer network is verified.
MEMWAL_NETWORK=
